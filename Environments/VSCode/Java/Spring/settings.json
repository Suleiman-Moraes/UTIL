{
    "java.configuration.updateBuildConfiguration": "interactive",
    "java.referencesCodeLens.enabled": true,
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/CVS": true,
        "**/.DS_Store": true,
        "**/target": true,
        "**mvn**": true
    },
    // "spring-boot.ls.java.home": "{path}\\jdk-17",
    // "java.jdt.ls.java.home": "{path}\\jdk-17",
    "java.configuration.runtimes": [
        {
            "name": "JavaSE-21",
            "path": "C:\\Program Files\\Java\\jdk21"
        },
        {
            "name": "JavaSE-25",
            "path": "C:\\Program Files\\Java\\jdk25",
            "default": true
        }
    ],
    "terminal.integrated.env.windows": {
        "JAVA_HOME": "C:\\Program Files\\Java\\jdk25",
        "M2_HOME": "{path}\\maven",
        "MAVEN_HOME": "{path}\\maven",
        "PATH": "C:\\Program Files\\Java\\jdk25\\bin;{path}\\maven\\bin;C:\\Program Files\\Git\\bin;{env:PATH}"
    },
    "actionButtons": {
        "commands": [
            {
                "name": "MVN_TEST",
                "color": "yellow",
                "command": "mvn -o test"
            },
            {
                "name": "JACOCO",
                "color": "yellow",
                "command": "mvn jacoco:report"
            }
        ]
    },
    "java.compile.nullAnalysis.mode": "disabled",
    "java.jdt.ls.vmargs": "-XX:+UseParallelGC -XX:GCTimeRatio=4 -XX:AdaptiveSizePolicyWeight=90 -Dsun.zip.disableMemoryMapping=true -Xmx2G -Xms100m -Xlog:disable"
}
